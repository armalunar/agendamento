rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O projeto usa API Routes com Firebase Admin SDK para criar pedidos,
    // listar ordens e marcar como concluída. O Admin SDK ignora estas rules.
    // Assim, o cliente não acessa diretamente o Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
